{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/models/pub_account_info/*": ["./src/logic/models/account/*"],
      "@/models/availability/*": ["./src/logic/models/account/schedule/availability/*"],
      "@/models/match_event/*": ["./src/logic/models/account/schedule/match_event/*"],
      "@/models/matchplan/*": ["./src/logic/models/matchplan/*"],
      "@/models/*": ["./src/logic/models/*"],
      "@/*": ["./src/*"]
    }
  }
}
